export struct CatOpt {
    id: int,
    name: string,
    kind: string,
    icon: string,
    tint: color,
    keywords: string,
}

export struct TxRow {
    // header rows group the list by day
    header: bool,
    header-text: string,
    header-total: string,
    id: int,
    kind: string,
    note: string,
    cat-id: int,
    cat-name: string,
    icon: string,
    tint: color,
    amount-text: string,
    amount-raw: string,
    date: string,
    date-text: string,
    tag: string,
    acc-id: int,
}

export struct CatStat {
    id: int,
    name: string,
    icon: string,
    tint: color,
    planned-text: string,
    spent-text: string,
    projected-text: string,
    ratio: float,
    proj-ratio: float,
    status: string,
    share: float,
    has-plan: bool,
}

export struct InsightRow {
    tone: string,
    title: string,
    body: string,
}

export struct DueRow {
    id: int,
    kind: string,
    name: string,
    amount-text: string,
    date-text: string,
    overdue: bool,
}

export struct BarDatum {
    label: string,
    a: float,
    b: float,
    a-text: string,
    b-text: string,
    current: bool,
}

export struct BudgetRow {
    cat-id: int,
    name: string,
    icon: string,
    tint: color,
    planned-raw: string,
    planned-text: string,
    spent-text: string,
    ratio: float,
    remaining-text: string,
    over: bool,
    suggested: int,
    suggested-text: string,
    hint: string,
}

export struct InstSeg {
    // paid | late | due | upcoming
    status: string,
}

export struct SchedRow {
    n: int,
    date-text: string,
    amount-text: string,
    status: string,
}

export struct DebtRow {
    id: int,
    name: string,
    lender: string,
    balance: float,
    balance-text: string,
    start-text: string,
    paid-text: string,
    progress: float,
    apr-text: string,
    min-text: string,
    due-text: string,
    days-to-due: int,
    payoff-text: string,
    interest-text: string,
    settled: bool,
    trapped: bool,
    // edit form seeds
    raw-start: string,
    raw-apr: string,
    raw-min: string,
    raw-due: string,
    raw-lender: string,
    tint: color,
    is-inst: bool,
    tenor: int,
    paid-n: int,
    next-text: string,
    segs: [InstSeg],
    sched: [SchedRow],
}

export struct Seg {
    start: float,
    len: float,
    tint: color,
}

export struct LoadBar {
    label: string,
    total-text: string,
    segs: [Seg],
    current: bool,
}

export struct LegendItem {
    name: string,
    tint: color,
