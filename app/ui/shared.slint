import { T, Api } from "theme.slint";
import { D } from "data.slint";
import { TxRow } from "types.slint";
import { Icon, IconButton, Button, CatBadge, Card, Pill, Ripple, Money, Enter } from "components.slint";

export component MonthSwitch inherits Rectangle {
    height: T.h-control;
    width: lay.preferred-width;
    border-radius: T.r-control;
    background: T.tonal;
    lay := HorizontalLayout {
        padding-left: 2px;
        padding-right: 2px;
        spacing: 2px;
        IconButton {
            y: 2px;
            icon: "left";
            clicked => { D.month-shift(-1); }
        }
        Text {
            text: D.month-label;
            min-width: 112px;
            horizontal-alignment: center;
            vertical-alignment: center;
            font-size: T.fs-body;
            font-weight: 600;
            color: T.text;
        }
        IconButton {
            y: 2px;
            icon: "right";
            clicked => { D.month-shift(1); }
        }
    }
}

export component PageHeader inherits HorizontalLayout {
    in property <string> title;
    in property <string> subtitle;
    in property <bool> month: true;
    spacing: 12px;
    VerticalLayout {
        alignment: center;
        spacing: 2px;
        Text {
            text: root.title;
            font-size: 26px;
            font-weight: 600;
            letter-spacing: -0.5px;
            color: T.text;
        }
        if root.subtitle != "" : Text {
            text: root.subtitle;
            font-size: T.fs-body;
            color: T.text3;
            wrap: word-wrap;
        }
    }
    Rectangle { horizontal-stretch: 1; }
    if root.month && !D.is-current : Button {
        y: (parent.height - self.height) / 2;
        kind: "text";
        compact: true;
        label: "Bulan ini";
        clicked => { D.month-today(); }
    }
    if root.month : MonthSwitch { y: (parent.height - self.height) / 2; }
    @children
}

// One transaction line. Header rows render as a day divider with its total.
export component TxLine inherits Rectangle {
    in property <TxRow> tx;
    in property <int> order;
    callback open(TxRow);
    height: tx.header ? 36px : 56px;
    if tx.header : HorizontalLayout {
        padding-top: 12px;
        padding-left: 4px;
        padding-right: 4px;
        Text {
            text: tx.header-text;
            font-size: T.fs-cap;
            font-weight: 600;
            color: T.text3;
            vertical-alignment: center;
        }
        Text {
            text: tx.header-total;
            horizontal-alignment: right;
            font-size: T.fs-cap;
            color: T.text3;
            vertical-alignment: center;
        }
    }
    if !tx.header : Enter {
        order: root.order;
        Rectangle {
            border-radius: T.r-md;
            Ripple {
                border-radius: T.r-md;
                clicked => { root.open(root.tx); }
            }
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 12px;
                spacing: 12px;
                CatBadge {
                    y: (parent.height - self.height) / 2;
                    icon: tx.icon;
                    tint: tx.tint;
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: tx.note != "" ? tx.note : tx.cat-name;
                        font-size: T.fs-body + 1px;
                        font-weight: 500;
                        color: T.text;
                        overflow: elide;
                    }
                    Text {
                        text: tx.tag != "" ? tx.cat-name + ", " + tx.tag : tx.cat-name;
                        font-size: T.fs-cap;
                        color: T.text3;
                        overflow: elide;
                    }
                }
                Text {
                    text: (tx.kind == "income" ? "+" : "-") + tx.amount-text;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    font-size: T.fs-body + 1px;
                    font-weight: 600;
                    color: tx.kind == "income" ? T.pos : T.text;
                }
            }
        }
    }
}

export component Kpi inherits Card {
    in property <string> label;
    in property <float> value;
    in property <string> exact;
    in property <string> caption;
    in property <string> icon;
    in property <color> tint: T.text2;
    in property <int> order;
    min-height: 112px;
    Enter {
        order: root.order;
        VerticalLayout {
            padding: 20px;
            spacing: 6px;
            HorizontalLayout {
                spacing: 8px;
                Icon { name: root.icon; tint: root.tint; size: 16px; }
                Text {
                    text: root.label;
                    font-size: T.fs-cap + 0.5px;
                    font-weight: 600;
                    color: T.text2;
                    vertical-alignment: center;
                }
            }
            Money {
                value: root.value;
                exact: root.exact;
                font-size: 22px;
                font-weight: 600;
            }
            Text {
                text: root.caption;
                font-size: T.fs-cap;
                color: T.text3;
                wrap: word-wrap;
            }
        }
    }
}

export component InsightCard inherits Rectangle {
    in property <string> tone;
    in property <string> title;
    in property <string> body;
    in property <int> order;
    border-radius: T.r-md;
    background: tone == "bad" ? T.neg-soft : tone == "warn" ? T.warn-soft : tone == "good" ? T.pos-soft : T.tonal;
    Enter {
        order: root.order;
        HorizontalLayout {
            padding: 12px;
            spacing: 10px;
            Icon {
                y: 0;
                name: tone == "bad" || tone == "warn" ? "alert" : tone == "good" ? "check" : "bulb";
                tint: tone == "bad" ? T.neg : tone == "warn" ? T.warn : tone == "good" ? T.pos : T.accent;
                size: 18px;
            }
            VerticalLayout {
                spacing: 3px;
                Text {
                    text: root.title;
                    font-size: T.fs-body;
                    font-weight: 600;
                    color: T.text;
                    wrap: word-wrap;
                }
                Text {
                    text: root.body;
                    font-size: T.fs-cap + 0.5px;
                    color: T.text2;
                    wrap: word-wrap;
                }
            }
        }
    }
}

// One-line stat card: icon, label, value. Same height and padding everywhere.
export component MiniStat inherits Card {
    in property <string> icon;
    in property <color> tint: T.text2;
    in property <string> label;
    in property <string> value;
    in property <color> value-color: T.text;
    in property <int> order;
    height: 60px;
    preferred-width: 10px;
    horizontal-stretch: 1;
    HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        spacing: 10px;
        Icon { y: (parent.height - self.height) / 2; name: root.icon; tint: root.tint; size: 16px; }
        Text { text: root.label; font-size: T.fs-body; color: T.text2; vertical-alignment: center; overflow: elide; }
        Text { text: root.value; horizontal-alignment: right; font-size: T.fs-head; font-weight: 500; color: root.value-color; vertical-alignment: center; }
    }
}
