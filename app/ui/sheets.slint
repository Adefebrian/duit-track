export component EntrySheet inherits Sheet {
    title: (D.ge-kind == 0 ? "Setor ke " : "Tarik dari ") + D.goal-current.name;
    open: D.entry-sheet;
    dismiss => { D.entry-sheet = false; }
    Segmented {
        items: ["Setor", "Tarik"];
        index <=> D.ge-kind;
    }
    HorizontalLayout {
        spacing: 12px;
        Field { label: "Nominal"; placeholder: D.goal-current.freq == 0 ? D.goal-current.per-day-text : D.goal-current.freq == 1 ? D.goal-current.per-week-text : D.goal-current.per-month-text; text <=> D.ge-amount; money: true; }
        VerticalLayout {
            spacing: 6px;
            Text { text: "Tanggal"; font-size: T.fs-cap; font-weight: 600; color: T.text2; }
            DateStepper { date <=> D.ge-date; }
        }
    }
    Field { label: "Catatan"; placeholder: "opsional"; text <=> D.ge-note; }
    if D.ge-error != "" : ErrorText { text: D.ge-error; }
    Actions {
        Button { kind: "outline"; label: "Batal"; clicked => { D.entry-sheet = false; } }
        Button { label: "Simpan"; icon: "check"; clicked => { D.entry-save(); } }
    }
}

export component CatSheet inherits Sheet {
    title: D.c-id == 0 ? "Kategori baru" : "Ubah kategori";
    open: D.cat-sheet;
    dismiss => { D.cat-sheet = false; }
    Field { label: "Nama"; placeholder: "Kopi"; text <=> D.c-name; }
    Field { label: "Kata kunci"; placeholder: "kopi, starbucks, janji jiwa"; text <=> D.c-keywords; }
    IconPicker { selected <=> D.c-icon; tint: T.palette[D.c-color]; }
    ColorPicker { selected <=> D.c-color; }
    if D.c-error != "" : ErrorText { text: D.c-error; }
    HorizontalLayout {
        spacing: 8px;
        if D.c-id != 0 : Button { kind: "danger"; label: "Arsipkan"; clicked => { D.cat-archive(D.c-id); } }
        Rectangle { }
        Button { kind: "outline"; label: "Batal"; clicked => { D.cat-sheet = false; } }
        Button { label: "Simpan"; icon: "check"; clicked => { D.cat-save(); } }
    }
}

export component ResetSheet inherits Sheet {
    title: "Hapus semua data?";
    open: D.reset-sheet;
    sheet-width: 420px;
    dismiss => { D.reset-sheet = false; }
    Text {
        text: "Semua data dihapus permanen. Ekspor cadangan dulu jika ragu.";
        wrap: word-wrap;
        font-size: T.fs-body;
        color: T.text2;
    }
    Actions {
        Button { kind: "outline"; label: "Batal"; clicked => { D.reset-sheet = false; } }
        Button { kind: "danger"; icon: "trash"; label: "Hapus permanen"; clicked => { D.reset-all(); } }
    }
}

export component Toast inherits Rectangle {
    property <float> k: D.toast-show ? 1 : 0;
    animate k { duration: T.motion ? 280ms : 0ms; easing: cubic-bezier(0.2, 0, 0, 1); }
    visible: k > 0.01;
    width: lay.preferred-width;
    height: 44px;
    border-radius: T.r-inner;
    background: T.inverse;
    opacity: k;
    lay := HorizontalLayout {
        padding-left: 18px;
        padding-right: D.toast-undo ? 6px : 18px;
        spacing: 12px;
        Text { text: D.toast; color: T.on-inverse; font-size: T.fs-body; vertical-alignment: center; }
        if D.toast-undo : Rectangle {
            y: 6px;
            height: 32px;
            width: u.preferred-width + 24px;
            border-radius: T.r-control;
            Ripple {
                border-radius: T.r-control;
                tone: T.on-inverse;
                clicked => { D.undo(); }
            }
            u := Text { text: "Urungkan"; color: T.inverse-accent; font-weight: 600; font-size: T.fs-body; }
        }
    }
}
