        name == "right" ? "M9 5l7 7-7 7" :
        name == "close" ? "M6 6l12 12 M18 6L6 18" :
        name == "check" ? "M5 12.5l4.5 4.5L19 7" :
        name == "trash" ? "M4 7h16 M9 7V4h6v3 M6 7l1 13h10l1-13" :
        name == "edit" ? "M4 20h4L19 9l-4-4L4 16z M13.5 6.5l4 4" :
        name == "repeat" ? "M17 3l3 3-3 3 M4 11V9.5A3.5 3.5 0 0 1 7.5 6H20 M7 21l-3-3 3-3 M20 13v1.5a3.5 3.5 0 0 1-3.5 3.5H4" :
        name == "bulb" ? "M9 18h6 M10 21h4 M12 3a6 6 0 0 0-3.8 10.6c.6.6.8 1.3.8 2.4h6c0-1.1.2-1.8.8-2.4A6 6 0 0 0 12 3z" :
