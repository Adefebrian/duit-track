import { T, Api } from "theme.slint";

// ---------- Icons: 24px grid line icons ----------

export component Icon inherits Path {
    in property <string> name;
    in property <color> tint: T.text2;
    in property <length> size: 18px;
    width: size;
    height: size;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: tint;
    stroke-width: 1.7px;
    fill: transparent;
    commands:
        name == "overview" ? "M4 4h7v7H4z M13 4h7v7h-7z M4 13h7v7H4z M13 13h7v7h-7z" :
        name == "analytics" ? "M3 20h18 M6 16v-5 M11 16V6 M16 16v-8 M21 16V9" :
        name == "list" ? "M9 6h11 M9 12h11 M9 18h11 M4 5.5v1 M4 11.5v1 M4 17.5v1" :
        name == "budget" ? "M12 3a9 9 0 1 0 9 9h-9z M14.5 2.8A9 9 0 0 1 21.2 9.5h-6.7z" :
        name == "income" ? "M12 3v11 M7 9.5l5 5 5-5 M4 16v4h16v-4" :
        name == "debt" ? "M3 6h18v12H3z M3 10h18 M7 14.5h4" :
        name == "card" ? "M3 6h18v12H3z M3 10h18 M7 14.5h4" :
        name == "settings" ? "M4 7h9 M17 7h3 M4 17h3 M11 17h9 M15 5v4 M9 15v4" :
        name == "plus" ? "M12 5v14 M5 12h14" :
        name == "food" ? "M7 3v7a2 2 0 0 0 4 0V3 M9 12v9 M17 3c-2.5 2-2.5 7 0 9v9" :
        name == "car" ? "M3 13l2.2-6h13.6l2.2 6v5H3z M3 13h18 M7 18v2 M17 18v2" :
        name == "bag" ? "M5 8h14l-1 13H6z M9 8V6.5a3 3 0 0 1 6 0V8" :
        name == "bolt" ? "M13 2L4.5 14H11l-1 8 8.5-12H12z" :
        name == "play" ? "M6 4.5v15l13-7.5z" :
        name == "heart" ? "M12 20s-7.5-4.6-7.5-10.2A4.2 4.2 0 0 1 12 7.2a4.2 4.2 0 0 1 7.5 2.6C19.5 15.4 12 20 12 20z" :
        name == "book" ? "M5 4.5A1.5 1.5 0 0 1 6.5 3H19v15H6.5A1.5 1.5 0 0 0 5 19.5z M5 19.5A1.5 1.5 0 0 0 6.5 21H19v-3" :
        name == "home" ? "M3 11l9-7 9 7 M5.5 9.5V20h13V9.5 M10 20v-6h4v6" :
        name == "gift" ? "M4 11h16v9H4z M3 7.5h18V11H3z M12 7.5V20 M12 7.5C10 3.5 6 4.5 7.5 7.5 M12 7.5c2-4 6-3 4.5 0" :
        name == "dots" ? "M5 12h2 M11 12h2 M17 12h2" :
        name == "wallet" ? "M3 7h16.5A1.5 1.5 0 0 1 21 8.5v10a1.5 1.5 0 0 1-1.5 1.5H3z M3 7l12-4v4 M16 13.5h2" :
        name == "star" ? "M12 3.5l2.6 5.4 5.9.8-4.3 4.1 1 5.8L12 16.8l-5.2 2.8 1-5.8-4.3-4.1 5.9-.8z" :
        name == "briefcase" ? "M3 7h18v13H3z M8.5 7V4h7v3 M3 12.5h18" :
        name == "trend" ? "M3 17l6-6 4 4 8-8 M15 7h6v6" :
        name == "search" ? "M10.5 4a6.5 6.5 0 1 0 0 13a6.5 6.5 0 1 0 0-13z M20 20l-4.8-4.8" :
